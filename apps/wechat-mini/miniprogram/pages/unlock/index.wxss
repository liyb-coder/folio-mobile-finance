.unlock-page {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 80rpx 48rpx;
  background: #dedee8;
}

.unlock-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  max-width: 620rpx;
  text-align: center;
}

.unlock-logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 36rpx;
  box-shadow: 0 22rpx 44rpx rgba(37, 38, 42, 0.16);
}

.unlock-brand {
  margin-top: 28rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.unlock-title {
  margin-top: 42rpx;
  font-size: 54rpx;
  font-weight: 800;
  line-height: 1.22;
  letter-spacing: -2rpx;
}

.unlock-copy {
  margin-top: 24rpx;
  color: #6f717b;
  font-size: 26rpx;
  line-height: 1.65;
}

.enter-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 104rpx;
  margin-top: 58rpx;
  border-radius: 32rpx;
  background: #25262a;
  color: #fff;
  font-size: 29rpx;
  font-weight: 700;
}

.enter-button image {
  width: 36rpx;
  height: 36rpx;
  margin-left: 18rpx;
}

.unlock-note {
  margin-top: 24rpx;
  color: #7f818b;
  font-size: 21rpx;
  line-height: 1.5;
}
