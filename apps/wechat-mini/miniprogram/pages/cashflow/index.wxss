.cashflow-page {
  padding-top: 0;
}

.cashflow-summary {
  padding: 36rpx 32rpx;
  background: #dedee8;
}

.summary-value {
  display: block;
  margin-top: 14rpx;
  font-size: 56rpx;
  font-weight: 800;
}

.summary-row {
  display: flex;
  gap: 70rpx;
  margin-top: 34rpx;
}

.summary-row view text {
  display: block;
  color: #7c7e88;
  font-size: 20rpx;
}

.summary-row view text + text {
  margin-top: 7rpx;
  color: #25262a;
  font-size: 25rpx;
  font-weight: 700;
}

.trend-card {
  margin-top: 22rpx;
  padding: 30rpx;
}

.trend-heading,
.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.trend-heading image {
  width: 42rpx;
  height: 42rpx;
}

.card-title {
  display: block;
  margin-top: 8rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.trend-summary-row {
  display: flex;
  justify-content: space-between;
  margin-top: 30rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #ececef;
}

.trend-summary-row view text {
  display: block;
  color: #858792;
  font-size: 18rpx;
}

.trend-summary-row view text + text {
  margin-top: 9rpx;
  color: #25262a;
  font-size: 23rpx;
  font-weight: 700;
}

.list-heading {
  margin: 30rpx 4rpx 18rpx;
}

.list-heading .section-title {
  margin: 0;
}

.list-heading button {
  margin: 0;
  padding: 10rpx 20rpx;
  border-radius: 18rpx;
  background: #25262a;
  color: #fff;
  font-size: 21rpx;
}

.flow-list {
  overflow: hidden;
  padding: 0 28rpx;
}

.flow-row {
  display: flex;
  align-items: center;
  min-height: 112rpx;
}

.flow-row + .flow-row {
  border-top: 1rpx solid #ececef;
}

.flow-dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 20rpx;
  border-radius: 50%;
  background: #9a9ca6;
}

.flow-dot.income {
  background: #9cc52d;
}

.flow-dot.expense {
  background: #7966ca;
}

.flow-copy {
  flex: 1;
}

.flow-title,
.flow-meta {
  display: block;
}

.flow-title {
  font-size: 25rpx;
  font-weight: 700;
}

.flow-meta {
  margin-top: 7rpx;
  color: #858792;
  font-size: 19rpx;
}

.flow-amount {
  font-size: 24rpx;
  font-weight: 700;
}

.flow-amount.income {
  color: #688516;
}
