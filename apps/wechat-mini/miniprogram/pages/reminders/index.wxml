<view class="page-shell reminders-page">
  <folio-header />

  <view class="milestone-card folio-card">
    <view class="milestone-icon"><image src="/assets/icons/calendar.png" mode="aspectFit" /></view>
    <view class="milestone-copy">
      <text class="eyebrow">下一个重要节点</text>
      <text class="milestone-title">8月20日 · 年度保费</text>
      <text class="subtle">已提前 9 天提醒，计划预留 ¥10,000</text>
    </view>
  </view>

  <view class="reminder-heading">
    <view><text class="section-title">财务事项</text><text class="subtle">按用途管理各类节点</text></view>
    <button bindtap="showPending">添加事项</button>
  </view>

  <view class="manager-card rent folio-card">
    <view class="manager-icon"><image src="/assets/icons/building.png" mode="aspectFit" /></view>
    <view class="manager-copy"><text class="manager-name">租金管家</text><text class="manager-state">1 个事项 · 下次 9月1日</text></view>
    <text class="manager-amount amount">¥8,000</text>
  </view>

  <view class="manager-card insurance folio-card">
    <view class="manager-icon"><image src="/assets/icons/shield.png" mode="aspectFit" /></view>
    <view class="manager-copy"><text class="manager-name">保险管家</text><text class="manager-state">1 个事项 · 下次 8月20日</text></view>
    <text class="manager-amount amount">¥10,000</text>
  </view>

  <view class="manager-card maturity folio-card">
    <view class="manager-icon"><image src="/assets/icons/clock.png" mode="aspectFit" /></view>
    <view class="manager-copy"><text class="manager-name">到期管家</text><text class="manager-state">1 个事项 · 下次 10月26日</text></view>
    <text class="manager-amount amount">¥300,000</text>
  </view>

  <text class="data-note">以上均为虚构演示事项</text>
</view>
