.assistant-page {
  padding-top: 0;
}

.assistant-hero {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  overflow: hidden;
  min-height: 590rpx;
  padding: 50rpx 34rpx 44rpx;
  border-radius: 42rpx;
  background: #dedee8;
  text-align: center;
}

.hero-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  border-radius: 31rpx;
  background: #c7f348;
}

.hero-mark image {
  width: 50rpx;
  height: 50rpx;
}

.hero-kicker {
  margin-top: 20rpx;
  color: #747680;
  font-size: 21rpx;
}

.hero-title {
  max-width: 600rpx;
  margin-top: 12rpx;
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.3;
  letter-spacing: -1.4rpx;
}

.hero-copy {
  margin-top: 16rpx;
  color: #757781;
  font-size: 22rpx;
  line-height: 1.6;
}

.assistant-composer {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  box-sizing: border-box;
  width: 100%;
  min-height: 96rpx;
  margin-top: 34rpx;
  padding: 10rpx 10rpx 10rpx 24rpx;
  border-radius: 30rpx;
  background: #fff;
  color: #a0a1a9;
  font-size: 20rpx;
  text-align: left;
}

.assistant-composer > image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 15rpx;
}

.assistant-composer > text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mic-end {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 74rpx;
  height: 74rpx;
  border-radius: 24rpx;
  background: #25262a;
}

.mic-end image {
  width: 34rpx;
  height: 34rpx;
}

.assistant-cat {
  position: absolute;
  right: -8rpx;
  bottom: -40rpx;
  width: 144rpx;
  height: 144rpx;
  opacity: 0.92;
}

.capability-grid {
  display: grid;
  gap: 18rpx;
  margin-top: 22rpx;
}

.capability-card {
  padding: 28rpx;
}

.capability-card > image {
  width: 52rpx;
  height: 52rpx;
}

.capability-title {
  display: block;
  margin: 18rpx 0 8rpx;
  font-size: 27rpx;
  font-weight: 750;
}

.integration-status {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 22rpx 26rpx;
  border-radius: 26rpx;
  background: #e8e8ed;
  color: #777984;
  font-size: 20rpx;
}
