.header-wrap {
  position: relative;
  z-index: 20;
}

.folio-header {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  padding: 10rpx 6rpx 8rpx;
}

.menu-button {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  margin: 0 14rpx 0 0;
  padding: 0;
  border-radius: 18rpx;
  background: transparent;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
}

.brand-logo {
  width: 66rpx;
  height: 66rpx;
  border-radius: 19rpx;
}

.brand-name {
  margin-left: 16rpx;
  color: #25262a;
  font-size: 40rpx;
  font-weight: 750;
  letter-spacing: -1.5rpx;
}

.header-spacer {
  flex: 1;
}

.demo-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #e5e5ea;
  color: #676974;
  font-size: 20rpx;
  font-weight: 650;
}

.menu-panel {
  position: absolute;
  top: 100rpx;
  left: 8rpx;
  width: 360rpx;
  overflow: hidden;
  border: 1rpx solid rgba(37, 38, 42, 0.08);
  border-radius: 28rpx;
  background: #fbfbfc;
  box-shadow: 0 24rpx 70rpx rgba(37, 38, 42, 0.17);
}

.menu-item {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 92rpx;
  padding: 0 24rpx;
  border-radius: 0;
  background: transparent;
  color: #25262a;
  font-size: 25rpx;
  text-align: left;
}

.menu-item + .menu-item {
  border-top: 1rpx solid #ececef;
}

.menu-item image {
  width: 34rpx;
  height: 34rpx;
  margin-right: 20rpx;
}
