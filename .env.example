# All VITE_* values are embedded in the client bundle and must be treated as public.
# Never place AI secrets, Supabase service_role/secret keys, passwords, or recovery keys here.

# demo | local | sync
VITE_DATA_MODE=demo
VITE_PUBLIC_DEMO_ENABLED=true

# Required only for optional browser/cloud sync.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase passkeys are experimental and require @supabase/supabase-js >= 2.105.
# Enable only after the production WebAuthn RP ID and HTTPS origins are final.
VITE_PASSKEY_AUTH_ENABLED=false

# Local desktop vault paths and private keys are managed by the Tauri native layer,
# not by Vite environment variables.
