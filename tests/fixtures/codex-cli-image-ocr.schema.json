{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "visibleText": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 240
    }
  },
  "required": ["visibleText", "summary"],
  "additionalProperties": false
}
